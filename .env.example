# Copy this file to .env and adjust as needed. None of these are required
# for local development — CatWAF runs with sane defaults out of the box.
#
# This file holds deployment secrets. Integration secrets also live in SQLite.
# Keep this file mode 600 (`chmod 600 .env`)
# — CatWAF warns at startup if other users on the machine can read it.

# Which edition is installed: lite or full.
#
#   lite  Caddy + Coraza + CRS, the catwaf CLI and the event database.
#         No HTTP API, no dashboard, no CatAI, no frontend dependencies.
#         `catwaf start` brings up the WAF, not a web server.
#   full  Everything above plus the API, the built dashboard and CatAI.
#
# Written by `catwaf setup --lite|--full`, and read by `npm install` (to decide
# whether to install frontend dependencies at all), by the CLI (to gate
# Full-only commands like `catwaf docker`) and by `catwaf status`.
#
# Leave unset and CatWAF infers it from whether a built dashboard is present,
# so installs that predate this setting keep working.
CATWAF_EDITION=full

# Set to 1 to stop `npm install` downloading a Caddy binary. Use this in
# container images and CI that supply Caddy separately.
# CATWAF_SKIP_CADDY_DOWNLOAD=1

# Automatic download pins Caddy v2.11.7 and coraza-caddy v2.6.2. An independently
# verified binary SHA-256 can also be required before the download is executed.
# CATWAF_CADDY_SHA256=

# Web bootstrap is disabled by default. Prefer the local `catwaf user add` CLI.
# To enable the first-account API, generate at least 32 random bytes and send
# the value in X-CatWAF-Setup-Token on EVERY /api/setup/* request. Remove after setup.
# CATWAF_SETUP_TOKEN=

# Docker Compose sets a private Caddy admin socket. Native installations may
# also set this to the filesystem path of their permissioned admin socket.
# CADDY_ADMIN_SOCKET=/run/catwaf-admin/admin.sock

# Port the API listens on (Full only — Lite runs no API server)
PORT=8000

# Your domain, e.g. example.com. `catwaf --setup` asks for this and writes
# it here — the dashboard then lives at catwaf.<DOMAIN> and the API at
# api.catwaf.<DOMAIN> (see src/tui/setup.js and the generated Caddyfile at
# the project root). Leave unset to run locally: the backend then serves the
# dashboard and the API together on http://localhost:${PORT} (8000 above).
DOMAIN=

# How many reverse-proxy hops in front of this API may set X-Forwarded-*.
# Unset, CatWAF infers it: 1 when DOMAIN or CATWAF_HTTPS is set (a proxied
# deployment), 0 otherwise — a direct deployment ignores client-supplied
# forwarded headers entirely, so rate limiting and IP checks cannot be
# steered by them. Set 0-8 explicitly only if you front the API with your
# own proxy without setting DOMAIN.
#TRUST_PROXY_HOPS=1

# Secret used to sign login JWTs.
#
# Leave this unset for local dev — the backend generates a random secret at
# boot automatically (see middleware/auth.js) and logs a warning that it's
# doing so. That's fine for a laptop, but it means every restart invalidates
# existing sessions, and it's not something to rely on for anything actually
# deployed. Set a real value before that:
#   openssl rand -hex 32
JWT_SECRET=

# Origin(s) OTHER than this server that may call the API from a browser
# (comma-separated for more than one).
#
# You usually do not need this. In the normal deployment CatWAF serves the
# dashboard itself, so every call is same-origin and is always allowed —
# whether you reach it as localhost, 127.0.0.1, a LAN address or a hostname.
# Set it only when the dashboard lives somewhere else: the Vite dev server, or
# a split deployment where the dashboard and the API are on different hosts.
CORS_ORIGIN=

# Whether this install is reached over HTTPS.
#
# Gates two headers that are right for a public HTTPS deployment and break a
# plain-HTTP one: Strict-Transport-Security, and the CSP's
# upgrade-insecure-requests (which browsers apply to a LAN address but not to
# localhost — that asymmetry is why an install could work on localhost and
# fail on an IP address).
#
# Left unset, CatWAF infers it from DOMAIN. Set it to true when TLS is
# terminated by something in front of CatWAF that this process cannot see, or
# false to force plain-HTTP behaviour.
# CATWAF_HTTPS=

# Where the SQLite database lives (created automatically if missing)
DB_DIR=./data
# DB_PATH=./data/catwaf.db   # set automatically from DB_DIR; override only
#                             # if you need a single custom file path

# Caddy integration — only relevant if you're running CatWAF in front of a
# real Caddy instance (see docs/reverse-proxy.md).
#
# Leave this UNSET and CatWAF finds the Caddyfile itself, in this order:
#   1. the --config path in caddy's systemd unit, if there is one
#   2. a Caddyfile that already contains CatWAF's markers (i.e. one we
#      have written before), preferring a writable one
#   3. the conventional locations: <project>/Caddyfile, /etc/caddy/Caddyfile,
#      /usr/local/etc/caddy/Caddyfile, and the Homebrew paths on macOS
#   4. <project>/Caddyfile, created on first write
#
# Set it explicitly to override all of that — detection never second-guesses
# an operator who has said where the file is. The chosen path is printed at
# startup, along with a warning if it isn't writable by this user.
CADDYFILE_PATH=
CORAZA_LIST_DIR=/etc/coraza/lists

# How CatWAF reloads Caddy when it changes WAF configuration.
#
# CatWAF does NOT use the Docker socket. It reloads Caddy either by running
# the local `caddy reload` binary (normal host installs) or, when that binary
# isn't present (containers), by POSTing the config to Caddy's own admin API
# at this URL. docker-compose.yml sets this to http://caddy:2019 and keeps
# port 2019 off the published port list, so it stays on the internal network.
CADDY_ADMIN_URL=http://127.0.0.1:2019

# Where Coraza writes its JSON audit log. CatWAF ingests this file to populate
# the dashboard.
#
# Coraza opens this file when the configuration is PROVISIONED, so it must be
# openable or Caddy refuses to load the WAF handler at all. CatWAF creates the
# directory and file for you before applying any configuration.
#
# Leave this UNSET to let CatWAF choose: it prefers /var/log/coraza/audit.json
# (the right location under Docker, where compose mounts a volume there) and
# falls back to <data dir>/logs/coraza-audit.json when that is not writable —
# which is the normal case for a host-native install running unprivileged.
#
# Set it explicitly to pin the location. An explicit path is never silently
# relocated: if CatWAF cannot create it, it reports an error instead.
#CORAZA_AUDIT_LOG=/var/log/coraza/audit.json

# ── Audit log rotation ───────────────────────────────────────────────────
# Coraza appends to its audit log forever and never prunes it, so CatWAF
# rotates it. Rotation retires the current file by pointing SecAuditLog at a
# new one (Coraza caches its writer by path and will not reopen a renamed
# file), drains the retired file into the database, then prunes old archives.
# The active log is never truncated or deleted.
#
# Days to keep rotated logs, and the age at which the active log rolls over.
#CATWAF_AUDIT_RETENTION_DAYS=30
# Size at which the active log rolls over.
#CATWAF_AUDIT_MAX_SIZE_MB=100
# How many rotated files to keep alongside the active one.
#CATWAF_AUDIT_MAX_FILES=10

# Extra origins the dashboard is allowed to call (comma-separated). Only needed
# if the dashboard and API are on different hostnames beyond the standard
# catwaf.<domain> / api.catwaf.<domain> split, which is handled automatically.
CATWAF_CONNECT_SRC=

# Where CatWAF looks for OWASP CRS rule files, used to give `catwaf rules`
# and `catwaf explain` real rule descriptions. Leave unset and CatWAF looks
# in the usual system locations and the Go module cache; if it finds nothing
# it falls back to rules observed in real traffic and says so rather than
# inventing descriptions. CRS itself always runs inside Caddy either way —
# this only affects CatWAF's local metadata index.
CATWAF_CRS_PATH=

# Absolute path to your web root. Without this the Sensitive Files webroot
# scanner has nothing to scan and says so — it does not invent findings.
WEBROOT_PATH=

# CatAI — an optional local assistant built into the dashboard (see the
# cat icon, bottom-right). Runs entirely on this machine via Ollama;
# nothing is sent anywhere. `catwaf --setup` offers to configure this for
# you, including picking a model sized for your hardware — set these by
# hand only if you're doing it outside setup.
#
# Off unless explicitly true. Turning this on with no model pulled just
# makes the assistant report itself unavailable, not error.
CATAI_ENABLED=
# Any tag from https://ollama.com/library/qwen3 works; 1.7b is the
# default setup recommends on anything more than one CPU core.
CATAI_MODEL=qwen3:1.7b
OLLAMA_URL=http://127.0.0.1:11434
# How long the model stays resident in memory between questions. Keeping it
# loaded avoids a 5-15s reload per turn but holds ~1.4GB the whole time. On a
# 1GB VPS set this to 0 and accept the reload — the firewall must win.
CATAI_KEEP_ALIVE=5m

# ─────────────────────────────────────────────────────────────────────────
# Optional — the protection and configuration layer
# ─────────────────────────────────────────────────────────────────────────
# Everything below is optional. Each has a working default, and leaving it
# unset never disables a feature silently: CatWAF reports what it could not
# do rather than pretending it did it.

# Extra hostnames CatWAF should treat as its own, beyond DOMAIN and its www
# form. Comma-separated. These feed the known-hosts list used by the
# "reject unknown Host/SNI" switch, so a hostname missing here is a hostname
# that gets refused once that switch is on.
CATWAF_EXTRA_HOSTS=

# Resolve ASN lookups from a local file instead of DNS. Without this, ASN is
# resolved over DNS via Team Cymru and cached — which needs outbound DNS and
# leaks the addresses being looked up to a third party. Point this at a file
# of "CIDR ASN Name" lines (# comments allowed) to resolve entirely offline:
#     198.51.100.0/24  AS64496  Example Networks
CATWAF_ASN_MAP=

# Base64-encoded Ed25519 public keys, comma-separated, that CatWAF will
# accept plugin signatures from. A plugin need not be signed to be installed
# by hand, but an unsigned one is labelled as such everywhere it appears, and
# installing from a URL requires a signature from a key listed here.
# Kernel-level ban drops: mirror active bans into an nftables set so banned
# addresses die at SYN, before Caddy. Requires root, nftables installed, and a
# host install (refuses inside containers). You must also enable it under
# Settings and add the forwarding rule yourself:
#   catwaf kernel-bans print-rules
CATWAF_KERNEL_BANS=

# Passphrase for encrypted backups (Settings → Backups → Encrypt). Minimum 8
# characters. Deliberately NOT stored in the database — losing it means the
# backups are undecryptable. Leave unset to write plaintext backups.
#CATWAF_BACKUP_PASSPHRASE=

# Base64-encoded Ed25519 public keys, comma-separated, that CatWAF will

# The address Caddy uses to reach CatWAF's own API for the forward_auth hop
# that runs the classification pipeline. Defaults to HOST, then 127.0.0.1.
# Only set this when Caddy and CatWAF are not on the same loopback — for
# example CatWAF in one container and Caddy in another.
# What address the API/dashboard binds to.
#   127.0.0.1 (default) — reachable from THIS machine only. Right for
#                         "installed on my laptop" or when Caddy fronts it.
#   0.0.0.0             — reachable from your network/LAN: open the dashboard
#                         at http://<server-ip>:8000. Plain HTTP — fine for a
#                         home lab, put a real domain+TLS in front before
#                         exposing it to the internet (see SECURITY.md).
HOST=127.0.0.1

# Port the API/dashboard listens on when no domain is configured.
PORT=8000

# The address Caddy uses to reach CatWAF's own API for the forward_auth hop
# that runs the classification pipeline. Defaults to HOST, then 127.0.0.1.
# Only set this when Caddy and CatWAF are not on the same loopback — for
# example CatWAF in one container and Caddy in another.
CATWAF_INTERNAL_HOST=
