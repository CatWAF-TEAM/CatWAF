# Dependencies
node_modules/

# Environment variables — only .env.example is committed.
.env
.env.*
!.env.example
frontend/.env.local
frontend/.env.*.local

# Runtime data (SQLite database + Caddy state) — never commit real WAF state.
# WAL mode writes -wal/-shm sidecars next to the database; the -wal file holds
# committed rows that are not yet checkpointed into the .db, so it is just as
# sensitive as the database itself.
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/*.pid
data/config-transaction.json
data/caddy/
*.sqlite
*.sqlite3

# Runtime artefacts written next to the database. Caddyfile backups can
# contain upstream addresses and generated secrets; the rotated Coraza audit
# logs contain full request data. Neither belongs in the repository.
data/backups/
data/certs/
data/logs/
data/coraza-audit*.json
data/coraza-dev-audit.json

# Written at runtime by backend/routes/cloudflare.js (gen-cert)
backend/data/

# Generated Caddy config written at runtime
/Caddyfile
/Caddyfile.bak
/Caddyfile.dev

# TLS material — no key or certificate is ever committed.
*.pem
*.key
*.crt
*.p12
*.pfx

# Build output
dist/
frontend/dist/
.next/
.cache/

# Vendored Caddy binary fetched by scripts/ensure-caddy.js
bin/vendor/

# Logs and debug output
*.log
logs/
npm-debug.log*
yarn-error.log*

# Test, coverage and profiling artefacts
coverage/
.nyc_output/
test-results/
playwright-report/
*.cpuprofile
*.heapsnapshot
*.heapprofile

# Scratch and backup files
*.tmp
*.temp
*.bak
*.old
*.orig
*.rej

# Never let an unrelated embedded repo sneak into the tree again.
/gclicker/

# Editor / OS metadata
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Local agent tooling and generated security reports — developer-side only.
.claude/settings.local.json
CLAUDE-SECURITY-*/

# Design notes kept alongside the code while a feature is being built.
# Not part of the shipped project.
catwaf-indev-ideas/

# SQLite coordination sidecars and transaction staging
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
data/config.lock
data/.restore-*
